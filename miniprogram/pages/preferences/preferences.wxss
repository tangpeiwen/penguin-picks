.preferences-screen { display: flex; flex-direction: column; }
.topbar { height: 76rpx; display: flex; align-items: center; justify-content: space-between; }
.back { display: flex; width: 76rpx; height: 76rpx; padding: 0; margin: 0; align-items: center; justify-content: flex-start; background: transparent; color: var(--ink); font-size: 48rpx; line-height: 1; }
.step { color: var(--red); font-family: var(--font-hand); font-size: 36rpx; font-weight: 400; letter-spacing: 4rpx; }.top-spacer { width: 76rpx; }
.page-heading { margin-top: 48rpx; }.page-title { white-space: pre-line; color: var(--red-dark); font-size: 66rpx; line-height: 1.23; }
.blue-stroke { width: 216rpx; height: 8rpx; margin: 15rpx 0 0 24rpx; border-radius: 50%; border-top: 7rpx solid var(--blue); transform: rotate(-3deg); }
.section { margin-top: 61rpx; animation-delay: 70ms; }.section-title { margin-bottom: 27rpx; font-family: var(--font-hand); font-weight: 400; font-size: 41rpx; }
.people-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }.people-chip { display: flex; min-width: 0; height: 210rpx; margin: 0; padding: 14rpx 10rpx 12rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 27rpx; color: var(--ink); font-family: var(--font-hand); font-size: 34rpx; line-height: 1; transition: color 150ms ease, background-color 150ms ease, box-shadow 150ms ease, transform 150ms ease; }.people-icon { width: 180rpx; height: 116rpx; margin-bottom: 7rpx; }
.people-chip.selected { border-color: rgba(166, 47, 46, .24); background: #dcebf2; color: var(--red-dark); box-shadow: 0 8rpx 0 rgba(116, 155, 175, .18); transform: translateY(-2rpx); }
.divider { margin-top: 60rpx; border-top: 2rpx dashed #dccbb8; }
.region-section { margin-top: 43rpx; animation-delay: 120ms; }.region-section-only { margin-top: 82rpx; }.section-hint { margin-left: 12rpx; color: var(--muted); font-family: var(--font-hand); font-size: 22rpx; font-weight: 400; }.region-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.region-chip { display: flex; min-width: 0; height: 96rpx; margin: 0; padding: 8rpx 10rpx; align-items: center; justify-content: center; border-radius: 25rpx; color: var(--ink); font-family: var(--font-hand); font-size: 30rpx; line-height: 1.18; text-align: center; white-space: normal; transition: color 150ms ease, background-color 150ms ease, box-shadow 150ms ease; }.region-chip.selected { background: var(--blue); color: var(--red-dark); border-color: transparent; box-shadow: 0 7rpx 0 rgba(78, 121, 148, .12); }
.submit { display: flex; height: 112rpx; margin: 42rpx 0 0; padding: 0 28rpx; align-items: center; justify-content: center; border-radius: 60rpx; background: #d8cbbb; color: rgba(255,255,255,.75); font-family: var(--font-hand); font-size: 43rpx; font-weight: 400; line-height: 1.1; letter-spacing: 5rpx; text-align: center; box-shadow: none; }.submit.ready { color: #fffaf2; background: var(--red); box-shadow: 0 11rpx 0 var(--red-dark); }.submit-pressed { transform: scale(.985); }
