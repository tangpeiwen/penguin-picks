.preferences-screen { display: flex; flex-direction: column; padding-top: calc(env(safe-area-inset-top) + 22rpx); padding-bottom: calc(env(safe-area-inset-bottom) + 26rpx); }
.topbar { height: 68rpx; display: flex; align-items: center; justify-content: space-between; }
.back { display: flex; width: 72rpx; height: 68rpx; padding: 0; margin: 0; align-items: center; justify-content: flex-start; background: transparent; color: var(--ink); font-size: 46rpx; line-height: 1; }
.step { color: var(--red); font-family: var(--font-hand); font-size: 35rpx; font-weight: 400; letter-spacing: 4rpx; }.top-spacer { width: 72rpx; }
.page-heading { margin-top: 22rpx; }.page-title { white-space: pre-line; color: var(--red-dark); font-size: 62rpx; line-height: 1.16; }
.blue-stroke { width: 190rpx; height: 7rpx; margin: 10rpx 0 0 20rpx; border-radius: 50%; border-top: 6rpx solid var(--blue); transform: rotate(-3deg); }
.section { margin-top: 34rpx; animation-delay: 70ms; }.section-title { margin-bottom: 16rpx; font-family: var(--font-hand); font-weight: 400; font-size: 40rpx; }
.people-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx 16rpx; }.people-chip { display: flex; min-width: 0; height: 184rpx; margin: 0; padding: 10rpx 10rpx 9rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 27rpx; color: var(--ink); font-family: var(--font-hand); font-size: 34rpx; line-height: 1; transition: color 150ms ease, background-color 150ms ease, box-shadow 150ms ease, transform 150ms ease; }.people-icon { width: 156rpx; height: 98rpx; margin-bottom: 5rpx; }
.people-chip.selected { border-color: rgba(166, 47, 46, .24); background: #dcebf2; color: var(--red-dark); box-shadow: 0 8rpx 0 rgba(116, 155, 175, .18); transform: translateY(-2rpx); }
.divider { margin-top: 32rpx; border-top: 2rpx dashed #dccbb8; }
.region-section { margin-top: 26rpx; animation-delay: 120ms; }.region-section-only { margin-top: 46rpx; }.section-hint { margin-left: 10rpx; color: var(--muted); font-family: var(--font-hand); font-size: 23rpx; font-weight: 400; }.region-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx 12rpx; }
.region-chip { display: flex; min-width: 0; height: 88rpx; margin: 0; padding: 6rpx 8rpx; align-items: center; justify-content: center; border-radius: 23rpx; color: var(--ink); font-family: var(--font-hand); font-size: 31rpx; line-height: 1.12; text-align: center; white-space: normal; transition: color 150ms ease, background-color 150ms ease, box-shadow 150ms ease; }.region-chip.selected { background: var(--blue); color: var(--red-dark); border-color: transparent; box-shadow: 0 7rpx 0 rgba(78, 121, 148, .12); }
.submit { display: flex; height: 100rpx; margin: 26rpx 0 0; padding: 0 28rpx; align-items: center; justify-content: center; border-radius: 54rpx; background: #d8cbbb; color: rgba(255,255,255,.75); font-family: var(--font-hand); font-size: 42rpx; font-weight: 400; line-height: 1.1; letter-spacing: 5rpx; text-align: center; box-shadow: none; }.submit.ready { color: #fffaf2; background: var(--red); box-shadow: 0 9rpx 0 var(--red-dark); }.submit-pressed { transform: scale(.985); }

/* Keep short screens compact. On tall phones, use the room to restore the
   relaxed vertical rhythm of the occasion page instead of leaving it below. */
@media (min-height: 760px) {
  .people-section { margin-top: 54rpx; }
  .divider { margin-top: 48rpx; }
  .region-section { margin-top: 42rpx; }
  .region-section-only { margin-top: 62rpx; }
  .submit { margin-top: 54rpx; }
}
