.preferences-screen { display: flex; flex-direction: column; }
.topbar { height: 66rpx; display: flex; align-items: center; justify-content: space-between; }
.back { width: 76rpx; height: 66rpx; padding: 0; margin: 0; background: transparent; color: var(--ink); font-size: 48rpx; line-height: 60rpx; text-align: left; }
.step { color: var(--red); font-family: var(--font-hand); font-size: 32rpx; font-weight: 400; letter-spacing: 3rpx; }.top-spacer { width: 76rpx; }
.page-title { margin-top: 76rpx; font-size: 54rpx; line-height: 1.35; }
.blue-stroke { width: 198rpx; height: 8rpx; margin: 12rpx 0 0 24rpx; border-radius: 50%; border-top: 6rpx solid var(--blue); transform: rotate(-3deg); }
.section { margin-top: 68rpx; animation-delay: 70ms; }.section-title { margin-bottom: 27rpx; font-family: var(--font-hand); font-weight: 400; font-size: 38rpx; }
.people-row { display: flex; gap: 15rpx; }.people-chip { flex: 1; height: 154rpx; min-width: 0; margin: 0; padding: 13rpx 3rpx; border-radius: 23rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; color: var(--ink); font-family: var(--font-hand); font-size: 28rpx; transition: all 120ms ease; }
.people-chip.selected { background: var(--red); color: #fffaf2; transform: rotate(-1deg); box-shadow: 0 9rpx 0 rgba(132, 32, 31, .16); }.people-icon { width: 92rpx; height: 76rpx; margin-bottom: 2rpx; }
.divider { margin-top: 60rpx; border-top: 2rpx dashed #dccbb8; }
.region-section { margin-top: 43rpx; animation-delay: 120ms; }.section-hint { margin-left: 12rpx; color: var(--muted); font-family: var(--font-hand); font-size: 21rpx; font-weight: 400; }.region-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.region-chip { position: relative; height: 78rpx; margin: 0; padding: 0 5rpx; border-radius: 22rpx; color: var(--ink); font-family: var(--font-hand); font-size: 24rpx; white-space: nowrap; }.region-chip.selected { background: var(--blue); color: var(--ink); border-color: transparent; box-shadow: 0 7rpx 0 rgba(78, 121, 148, .12); }.check { position: absolute; top: 5rpx; right: 10rpx; color: var(--red); font-family: sans-serif; font-size: 18rpx; }
.submit { height: 104rpx; margin: 42rpx 0 0; border-radius: 60rpx; background: #d8cbbb; color: rgba(255,255,255,.75); font-family: var(--font-hand); font-size: 37rpx; font-weight: 400; letter-spacing: 5rpx; box-shadow: none; }.submit.ready { color: #fffaf2; background: var(--red); box-shadow: 0 11rpx 0 var(--red-dark); }
