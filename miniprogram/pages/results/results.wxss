.results-screen { min-height: 100vh; padding-left: 30rpx; padding-right: 30rpx; box-sizing: border-box; }
.topbar { display: flex; height: 104rpx; align-items: center; justify-content: space-between; gap: 24rpx; }.nav-capsule { display: flex; width: 218rpx; height: 100rpx; padding: 6rpx; box-sizing: border-box; align-items: center; border: 2rpx solid #d5c4b2; border-radius: 52rpx; background: rgba(255,253,248,.96); box-shadow: 0 7rpx 18rpx rgba(78,52,41,.07); }.back, .home { display: flex; height: 88rpx; margin: 0; padding: 0; align-items: center; justify-content: center; background: transparent; color: var(--red-dark); }.back { width: 88rpx; flex: none; border-radius: 44rpx; }.back-glyph { width: 21rpx; height: 21rpx; border-left: 4rpx solid currentColor; border-bottom: 4rpx solid currentColor; transform: rotate(45deg); }.nav-divider { width: 2rpx; height: 38rpx; flex: none; background: #dfd0bf; }.home { min-width: 0; flex: 1; border-radius: 44rpx; font-family: var(--font-hand); font-size: 30rpx; line-height: 1; }.back:active, .home:active { background: #f3e7da; }
.summary { padding: 42rpx 20rpx 22rpx; color: var(--ink); text-align: center; }.summary-occasion { color: var(--red-dark); font-size: 46rpx; line-height: 1.24; }.summary-details { margin-top: 14rpx; color: #725f57; font-size: 32rpx; line-height: 1.4; }.summary-judgment { max-width: 650rpx; margin: 20rpx auto 0; color: #5f504a; font-size: 34rpx; line-height: 1.5; }
.filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4rpx; width: 100%; margin-top: 21rpx; padding: 6rpx; box-sizing: border-box; border: 2rpx solid #d5c4b2; border-radius: 31rpx; background: rgba(255,253,248,.9); box-shadow: 0 8rpx 20rpx rgba(78,52,41,.06); }.filter-chip { display: flex; align-items: center; justify-content: center; gap: 15rpx; min-width: 0; height: 96rpx; margin: 0; padding: 0 12rpx; box-sizing: border-box; border-radius: 25rpx; background: transparent; color: var(--ink); font-family: var(--font-hand); font-size: 35rpx; line-height: 1; transition: color 160ms ease, background-color 160ms ease; }.filter-label { min-width: 0; overflow: hidden; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }.filter-chevron { flex: none; width: 14rpx; height: 14rpx; margin-top: -7rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); transition: transform 160ms ease; }.filter-chevron.open { margin-top: 7rpx; transform: rotate(225deg); }.filter-chip.active { color: #fffaf2; background: var(--red); box-shadow: 0 5rpx 12rpx rgba(132,32,31,.16); }
.loading-state { display: flex; min-height: 520rpx; flex-direction: column; align-items: center; justify-content: center; color: var(--red-dark); }.loading-mascot { width: 150rpx; height: 150rpx; animation: thinking-bob 850ms ease-in-out infinite alternate; }.loading-copy { margin-top: 18rpx; font-size: 36rpx; letter-spacing: 4rpx; }
.result-list { margin-top: 18rpx; animation-delay: 90ms; }.restaurant-card { margin-bottom: 19rpx; overflow: hidden; border-color: rgba(115,78,62,.13); border-radius: 23rpx 28rpx 24rpx 26rpx; box-shadow: 0 11rpx 24rpx rgba(78,52,41,.09); transform: translateY(0) scale(1); transform-origin: center; transition: transform 130ms ease, border-color 130ms ease, background-color 130ms ease, box-shadow 130ms ease; }
.restaurant-card--pressed { border-color: rgba(166,47,46,.27); background: #fbf3e9; box-shadow: 0 4rpx 9rpx rgba(78,52,41,.1); transform: translateY(4rpx) scale(.992); }.restaurant-card--pressed .restaurant-name { color: var(--red); }
.card-main { display: flex; padding: 27rpx 32rpx 24rpx; box-sizing: border-box; }
.card-copy { min-width: 0; flex: 1; }
.card-heading { display: flex; align-items: flex-start; }
.restaurant-name { display: block; min-width: 0; flex: 1; color: var(--red-dark); font-size: 40rpx; line-height: 1.24; transition: color 130ms ease; }
.primary-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 11rpx; color: var(--ink); }
.cuisine { display: inline-flex; min-height: 44rpx; padding: 1rpx 15rpx 2rpx; box-sizing: border-box; align-items: center; border: 2rpx solid rgba(116,155,175,.23); border-radius: 12rpx 14rpx 11rpx 13rpx; background: rgba(189,216,232,.3); color: #69534b; font-size: 30rpx; line-height: 1.35; }
.price { color: #856860; font-size: 25rpx; font-weight: 400; line-height: 1.4; }
.location-row { display: flex; height: 56rpx; margin-top: 12rpx; align-items: center; justify-content: flex-start; }
.location-line { display: block; min-width: 0; flex: 0 1 auto; padding-right: 24rpx; box-sizing: border-box; overflow: hidden; color: #806e67; font-size: 25rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.navigate-button { display: flex; flex: none; width: 88rpx; height: 88rpx; margin: 0 0 0 -24rpx; padding: 0; align-items: center; justify-content: center; border-radius: 44rpx; background: transparent; }
.navigate-button:active { background: rgba(189,216,232,.25); }
.navigate-icon { width: 34rpx; height: 34rpx; transform: translateX(-12rpx); }
.restaurant-review { display: block; margin-top: 10rpx; overflow: hidden; color: #5f504a; font-size: 25rpx; line-height: 1.48; text-overflow: ellipsis; white-space: nowrap; }
.reservation { display: block; width: max-content; max-width: 100%; margin-top: 11rpx; padding: 4rpx 10rpx; box-sizing: border-box; overflow: hidden; border: 2rpx solid var(--red); border-radius: 8rpx; color: var(--red); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.reservation.easy { border-color: var(--blue-deep); color: var(--blue-deep); }
.map-view { position: relative; margin-top: 24rpx; animation-delay: 90ms; }.restaurant-map { width: 100%; height: 760rpx; border: 2rpx solid rgba(115,78,62,.12); border-radius: 28rpx; overflow: hidden; }.map-note { position: absolute; left: 50%; bottom: 24rpx; transform: translateX(-50%); width: max-content; max-width: 84%; padding: 17rpx 27rpx; border-radius: 28rpx; color: var(--muted); text-align: center; font-size: 24rpx; }
.change-batch { margin: 16rpx auto 0; padding: 24rpx 48rpx 34rpx; background: transparent; color: var(--red-dark); font-family: var(--font-hand); font-size: 30rpx; letter-spacing: 3rpx; }.change-batch text { margin-left: 12rpx; }.empty { margin: 80rpx 20rpx; padding: 80rpx 45rpx; border-radius: 28rpx; color: var(--muted); text-align: center; font-size: 26rpx; }.empty-face { margin-bottom: 20rpx; color: var(--red); font-family: serif; font-size: 70rpx; }
.sheet-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(56, 38, 33, .44); animation: mask-in 180ms ease-out; }.filter-sheet { width: 100%; padding: 16rpx 38rpx calc(env(safe-area-inset-bottom) + 36rpx); box-sizing: border-box; border-radius: 38rpx 38rpx 0 0; background: var(--paper); box-shadow: 0 -14rpx 50rpx rgba(57,38,32,.18); }.sheet-handle { width: 66rpx; height: 7rpx; margin: 0 auto 18rpx; border-radius: 8rpx; background: #c8b8a7; }.sheet-head { position: relative; display: flex; min-height: 96rpx; align-items: center; justify-content: center; }.sheet-title { color: var(--red-dark); font-size: 50rpx; line-height: 1.2; text-align: center; }.sheet-close { position: absolute; top: 4rpx; right: -12rpx; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0; padding: 0; background: transparent; color: var(--muted); font-size: 45rpx; line-height: 1; }.option-list { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 20rpx; }.option { display: flex; align-items: center; justify-content: center; height: 108rpx; margin: 0; padding: 0 20rpx; border: 2rpx solid #d9c8b5; border-radius: 24rpx; background: #fffdf8; color: var(--ink); font-family: var(--font-hand); font-size: 40rpx; line-height: 1.2; text-align: center; transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease, transform 150ms ease; }.option.full { grid-column: 1 / -1; }.option.selected { border-color: var(--red); color: #fffaf2; background: var(--red); box-shadow: 0 6rpx 13rpx rgba(132,32,31,.16); }.option:active { transform: scale(.98); }.filter-actions { display: grid; grid-template-columns: .8fr 1.2fr; gap: 18rpx; margin-top: 32rpx; }.filter-reset, .filter-apply { display: flex; align-items: center; justify-content: center; height: 104rpx; margin: 0; padding: 0 18rpx; border-radius: 52rpx; font-family: var(--font-hand); font-size: 39rpx; line-height: 1.2; text-align: center; }.filter-reset { border: 2rpx solid #cbb8a6; color: var(--muted); background: transparent; }.filter-apply { color: #fffaf2; background: var(--red); box-shadow: 0 7rpx 0 rgba(132,32,31,.22); }
.sheet-note { display: block; margin-top: 6rpx; color: #8d7a71; font-size: 23rpx; line-height: 1.5; text-align: center; }
.order-mask { position: fixed; z-index: 30; inset: 0; display: flex; align-items: center; justify-content: center; padding: calc(env(safe-area-inset-top) + 32rpx) 34rpx calc(env(safe-area-inset-bottom) + 32rpx); box-sizing: border-box; background: rgba(56,38,33,.52); animation: mask-in 180ms ease-out; }
.order-modal { position: relative; width: 100%; max-height: 100%; overflow-y: auto; }
.order-card { padding: 34rpx 38rpx 28rpx; border: 2rpx solid rgba(115,78,62,.14); border-radius: 30rpx 25rpx 32rpx 27rpx; background: var(--paper); box-shadow: 0 24rpx 70rpx rgba(57,38,32,.24); }.order-eyebrow { color: var(--muted); font-size: 18rpx; letter-spacing: 3rpx; }.order-name-row { display: flex; align-items: center; justify-content: flex-start; gap: 4rpx; margin-top: 14rpx; }.order-name { min-width: 0; flex: 0 1 auto; color: var(--red-dark); font-size: 43rpx; line-height: 1.2; }.order-meta { display: block; margin-top: 10rpx; color: var(--ink); font-size: 20rpx; }.order-location { display: block; margin-top: 5rpx; color: var(--muted); font-size: 18rpx; }.order-divider { height: 2rpx; margin: 20rpx 0 18rpx; background: repeating-linear-gradient(90deg, var(--line) 0 11rpx, transparent 11rpx 19rpx); }
.copy-icon-button { display: flex; flex: none; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin: 0; padding: 0; border-radius: 50%; background: transparent; }.copy-glyph { position: relative; width: 25rpx; height: 25rpx; }.copy-back, .copy-front { position: absolute; width: 17rpx; height: 17rpx; box-sizing: border-box; border: 2rpx solid #a72f2e; border-radius: 3rpx; }.copy-back { left: 1rpx; top: 1rpx; opacity: .5; }.copy-front { right: 1rpx; bottom: 1rpx; background: var(--paper); }
.dish-heading { color: var(--red-dark); font-size: 28rpx; }.dish-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 12rpx; }.dish-item { min-height: 82rpx; padding: 14rpx 15rpx; box-sizing: border-box; display: flex; align-items: center; border: 2rpx solid rgba(180,145,124,.12); border-radius: 18rpx 22rpx 17rpx 20rpx; background: #efe2d5; }.dish-item.wide { grid-column: 1 / -1; }.dish-index { flex: none; width: 43rpx; color: var(--red); font-size: 16rpx; letter-spacing: 1rpx; }.dish-name { min-width: 0; color: var(--ink); font-size: 23rpx; line-height: 1.3; }
.review-heading { margin-top: 20rpx; color: var(--red-dark); font-size: 26rpx; }.order-review { display: block; margin-top: 7rpx; color: #5f504a; font-size: 20rpx; line-height: 1.48; }.order-notes { margin-top: 14rpx; padding-top: 13rpx; border-top: 2rpx solid rgba(222,207,189,.65); display: grid; gap: 9rpx; }.order-note { display: grid; grid-template-columns: 55rpx 1fr; gap: 8rpx; color: #5f504a; font-size: 18rpx; line-height: 1.42; }.note-label { color: var(--red-dark); font-family: var(--font-hand); font-size: 20rpx; }.order-address-row { display: flex; align-items: center; justify-content: flex-start; gap: 4rpx; margin-top: 11rpx; }.order-address { min-width: 0; flex: 0 1 auto; color: var(--muted); font-size: 18rpx; line-height: 1.4; }
.order-actions { margin-top: 18rpx; }.order-action { width: 72%; height: 78rpx; margin: 0 auto; border-radius: 42rpx; font-family: var(--font-hand); font-size: 27rpx; letter-spacing: 2rpx; }.order-action.save { color: #fffaf2; background: var(--red); box-shadow: 0 8rpx 0 rgba(132,32,31,.28); }.order-action.save[disabled] { opacity: .72; }
.share-canvas { position: fixed; left: -10000px; top: 0; width: 630px; height: 1000px; pointer-events: none; }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes thinking-bob { from { transform: translateY(3rpx) rotate(-2deg); } to { transform: translateY(-7rpx) rotate(2deg); } }
