<view class="screen results-screen" style="padding-top: {{contentTop}}px;">
  <view class="topbar">
    <view class="nav-capsule">
      <button class="back" bindtap="goBack" aria-label="返回上一页"><view class="back-glyph"></view></button>
      <view class="nav-divider"></view>
      <button class="home" bindtap="goHome" aria-label="回到主页">主页</button>
    </view>
    <view-toggle
      value="{{viewMode}}"
      map-disabled="{{mapDisabled}}"
      bind:change="changeView"
      bind:unavailable="showMapUnavailable"
    ></view-toggle>
  </view>

  <view class="summary fade-up">
    <view class="summary-occasion hand-title">{{summary.occasion}}</view>
    <view class="summary-details hand-title">{{summary.details}}</view>
    <view class="summary-judgment hand-title">「{{summary.judgment}}」</view>
  </view>

  <view class="filters">
    <button class="filter-chip {{filters.cuisine.length ? 'active' : ''}}" data-key="cuisine" bindtap="openFilter" aria-expanded="{{activeFilter === 'cuisine'}}">
      <text class="filter-label">{{filterLabels.cuisine}}</text><view class="filter-chevron {{activeFilter === 'cuisine' ? 'open' : ''}}"></view>
    </button>
    <button class="filter-chip {{filters.price.length ? 'active' : ''}}" data-key="price" bindtap="openFilter" aria-expanded="{{activeFilter === 'price'}}">
      <text class="filter-label">{{filterLabels.price}}</text><view class="filter-chevron {{activeFilter === 'price' ? 'open' : ''}}"></view>
    </button>
    <button class="filter-chip {{filters.diet.length ? 'active' : ''}}" data-key="diet" bindtap="openFilter" aria-expanded="{{activeFilter === 'diet'}}">
      <text class="filter-label">{{filterLabels.diet}}</text><view class="filter-chevron {{activeFilter === 'diet' ? 'open' : ''}}"></view>
    </button>
  </view>

  <view wx:if="{{loading}}" class="loading-state fade-up">
    <image class="loading-mascot" src="/assets/icons/mascot-red.png" mode="aspectFit"></image>
    <text class="loading-copy hand-title">让我想想…</text>
  </view>

  <view wx:elif="{{viewMode === 'list'}}" class="result-list fade-up">
    <view
      wx:for="{{results}}"
      wx:key="id"
      class="restaurant-card paper-card"
      data-id="{{item.id}}"
      bindtap="openOrderCard"
      hover-class="restaurant-card--pressed"
      hover-start-time="20"
      hover-stay-time="90"
      aria-role="button"
      aria-label="打开{{item.name}}的点菜卡"
    >
      <view class="card-main">
        <view class="card-copy">
          <view class="card-heading">
            <text class="restaurant-name hand-title">{{item.name}}</text>
          </view>
          <view class="primary-meta">
            <text class="cuisine hand-title">{{item.cuisineLabel}}</text>
            <text class="price">{{item.priceDisplay}}</text>
          </view>
          <view class="location-row">
            <text class="location-line">{{item.locationSummary}}</text>
            <button
              class="navigate-button"
              data-id="{{item.id}}"
              catchtap="openLocation"
              aria-label="打开{{item.name}}的地图导航"
            ><image class="navigate-icon" src="/assets/icons/location-pin-red.png" mode="aspectFit"></image></button>
          </view>
          <text class="restaurant-review">{{item.review}}</text>
          <text wx:if="{{item.reservationDisplay}}" class="reservation {{item.reservationLevel}}">{{item.reservationDisplay}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!results.length}}" class="empty paper-card">
      <view class="empty-face">⌣</view>
      <text>这个组合我还真没吃到过</text>
    </view>
  </view>

  <view wx:elif="{{viewMode === 'map' && !orderCard}}" class="map-view fade-up">
    <map
      class="restaurant-map"
      latitude="{{mapLatitude}}"
      longitude="{{mapLongitude}}"
      scale="12"
      markers="{{mapMarkers}}"
      include-points="{{mapPoints}}"
      bindcallouttap="openMarkerLocation"
      enable-zoom="{{true}}"
      enable-scroll="{{true}}"
    ></map>
    <view class="map-note paper-card">当前筛选共 {{mapMarkers.length}} 家 · 点标记看店名，再点店名导航</view>
  </view>

  <view wx:if="{{orderCard}}" class="order-mask" bindtap="closeOrderCard">
    <view class="order-modal">
      <view class="order-card" catchtap="noop">
        <text class="order-eyebrow">PEIWEN PICKS · 点菜卡</text>
        <view
          class="order-name-row"
          data-value="{{orderCard.name}}"
          data-label="店名"
          bindlongpress="copyText"
        >
          <view class="order-name hand-title">{{orderCard.name}}</view>
          <button class="copy-icon-button" data-value="{{orderCard.name}}" data-label="店名" bindtap="copyText" aria-label="复制店名">
            <view class="copy-glyph"><view class="copy-back"></view><view class="copy-front"></view></view>
          </button>
        </view>
        <text class="order-meta">{{orderCard.cuisineLabel}} · {{orderCard.priceDisplay}}</text>
        <text class="order-location">{{orderCard.locationSummary}}</text>
        <block wx:if="{{orderCard.cardDishes.length}}">
          <view class="order-divider"></view>
          <view class="dish-heading hand-title">{{orderCard.dishHeading}}</view>
          <view class="dish-list">
            <view
              wx:for="{{orderCard.cardDishes}}"
              wx:for-item="dish"
              wx:key="*this"
              class="dish-item {{orderCard.cardDishes.length % 2 === 1 && index === orderCard.cardDishes.length - 1 ? 'wide' : ''}}"
            >
              <text class="dish-index">0{{index + 1}}</text>
              <text class="dish-name">{{dish}}</text>
            </view>
          </view>
        </block>
        <view class="review-heading hand-title">我的一句话</view>
        <text class="order-review">{{orderCard.cardReview}}</text>
        <view wx:if="{{orderCard.pitfall || orderCard.reservationDisplay}}" class="order-notes">
          <view wx:if="{{orderCard.pitfall}}" class="order-note">
            <text class="note-label">避雷</text>
            <text>{{orderCard.pitfall}}</text>
          </view>
          <view wx:if="{{orderCard.reservationDisplay}}" class="order-note">
            <text class="note-label">订位</text>
            <text>{{orderCard.reservationDisplay}}</text>
          </view>
        </view>
        <view
          class="order-address-row"
          data-value="{{orderCard.address}}"
          data-label="地址"
          bindlongpress="copyText"
        >
          <text class="order-address">{{orderCard.address}}</text>
          <button class="copy-icon-button" data-value="{{orderCard.address}}" data-label="地址" bindtap="copyText" aria-label="复制地址">
            <view class="copy-glyph"><view class="copy-back"></view><view class="copy-front"></view></view>
          </button>
        </view>
      </view>
      <view class="order-actions" catchtap="noop">
        <button class="order-action save" bindtap="saveOrderCard" disabled="{{cardRendering}}">{{cardRendering ? '正在生成…' : '保存图片'}}</button>
      </view>
    </view>
  </view>

  <canvas canvas-id="orderCardCanvas" class="share-canvas"></canvas>

  <button class="change-batch" bindtap="changeBatch">换一批 <text>→</text></button>

  <view wx:if="{{activeFilter}}" class="sheet-mask" bindtap="closeFilter">
    <view class="filter-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-title hand-title">{{activeTitle}}</view>
        <button class="sheet-close" bindtap="closeFilter" aria-label="关闭筛选">×</button>
      </view>
      <text wx:if="{{activeFilter === 'diet'}}" class="sheet-note">仅按现有餐厅信息初筛；涉及过敏原，请订位时再和餐厅确认。</text>
      <view class="option-list">
        <button
          wx:for="{{activeOptions}}"
          wx:key="id"
          class="option {{item.full ? 'full' : ''}} {{item.selected ? 'selected' : ''}}"
          data-value="{{item.id}}"
          bindtap="toggleFilterOption"
          aria-pressed="{{item.selected}}"
        >{{item.label}}</button>
      </view>
      <view class="filter-actions">
        <button class="filter-reset" bindtap="resetDraftFilter">重置</button>
        <button class="filter-apply" bindtap="applyFilter">查看结果{{draftValues.length ? ' · ' + draftValues.length : ''}}</button>
      </view>
    </view>
  </view>
</view>
