.occasion-screen { position: relative; display: flex; flex-direction: column; overflow: visible; padding-left: 34rpx; padding-right: 34rpx; }
.hero { margin-top: 30rpx; }
.brand-lockup { display: flex; align-items: baseline; gap: 14rpx; padding-right: 205rpx; color: var(--red-dark); }.brand-en { font-size: 19rpx; font-weight: 600; letter-spacing: 4rpx; }.brand-cn { font-size: 25rpx; letter-spacing: 3rpx; }
.title { margin-top: 34rpx; font-size: 76rpx; line-height: 1.18; color: var(--red-dark); }.title-first-line { display: flex; width: max-content; flex-direction: column; align-items: flex-start; }.title-second-line { margin-top: 3rpx; }
.blue-stroke { width: 218rpx; height: 8rpx; margin: -2rpx 0 7rpx 12rpx; border-radius: 50%; border-top: 7rpx solid var(--blue); transform: rotate(-3deg); }
.hero-note { display: block; margin-top: 23rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; letter-spacing: 1rpx; }
.mascot { position: absolute; z-index: 1; top: calc(env(safe-area-inset-top) + 22rpx); right: 8rpx; width: 210rpx; height: 210rpx; transform: rotate(2deg); }
.occasion-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx 22rpx; animation-delay: 80ms; }
.primary-grid { margin-top: 30rpx; }
.occasion-card { height: 296rpx; margin: 0; padding: 20rpx 12rpx 17rpx; border-radius: 29rpx 35rpx 31rpx 27rpx; color: var(--ink); display: flex; flex-direction: column; align-items: center; justify-content: center; transition: transform 120ms ease, box-shadow 120ms ease; }
.occasion-card.blue { background: var(--blue); border-color: rgba(64, 105, 130, .12); color: var(--ink); }
.occasion-card.red { background: var(--red); border-color: rgba(132, 32, 31, .16); color: #fffdf8; text-shadow: 0 2rpx 3rpx rgba(91, 20, 20, .22); }
.occasion-card.selected { transform: translateY(-5rpx) rotate(-1deg); box-shadow: 0 13rpx 0 rgba(132, 32, 31, .16); }
.occasion-icon { width: 142rpx; height: 126rpx; }
.occasion-icon-parents { transform: scale(1.28); }
.occasion-label { margin-top: 10rpx; font-family: var(--font-hand); font-weight: 400; font-size: 42rpx; line-height: 1.15; letter-spacing: 3rpx; }
.occasion-divider { height: 2rpx; margin: 22rpx 2rpx 20rpx; background: repeating-linear-gradient(90deg, var(--line) 0 12rpx, transparent 12rpx 20rpx); animation-delay: 130ms; }
.secondary-grid { animation-delay: 160ms; }
.card-pressed { transform: scale(.97); }
.browse { display: flex; min-height: 92rpx; margin: 28rpx auto 0; padding: 18rpx 30rpx 8rpx; align-items: center; justify-content: center; background: transparent; color: var(--ink); font-family: var(--font-hand); font-size: 36rpx; line-height: 1.2; letter-spacing: 2rpx; text-align: center; }.browse text { margin-left: 12rpx; color: var(--red); }.browse-pressed { opacity: .55; }
