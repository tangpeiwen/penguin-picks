.occasion-screen { position: relative; display: flex; flex-direction: column; overflow: visible; padding: calc(env(safe-area-inset-top) + 18rpx) 34rpx calc(env(safe-area-inset-bottom) + 24rpx); }
.hero { margin-top: 16rpx; }
.brand-lockup { display: flex; align-items: baseline; gap: 14rpx; padding-right: 205rpx; color: var(--red-dark); }.brand-en { font-size: 19rpx; font-weight: 600; letter-spacing: 4rpx; }.brand-cn { font-size: 25rpx; letter-spacing: 3rpx; }
.title { margin-top: 20rpx; font-size: 68rpx; line-height: 1.12; color: var(--red-dark); }.title-first-line { display: flex; width: max-content; flex-direction: column; align-items: flex-start; }.title-second-line { margin-top: 1rpx; }
.blue-stroke { width: 202rpx; height: 7rpx; margin: -2rpx 0 4rpx 12rpx; border-radius: 50%; border-top: 7rpx solid var(--blue); transform: rotate(-3deg); }
.hero-note { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.4; letter-spacing: 1rpx; }
.mascot { position: absolute; z-index: 1; top: calc(env(safe-area-inset-top) + 10rpx); right: 8rpx; width: 184rpx; height: 184rpx; transform: rotate(2deg); }
.occasion-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx 18rpx; animation-delay: 80ms; }
.primary-grid { margin-top: 18rpx; }
.occasion-card { height: 244rpx; margin: 0; padding: 12rpx 10rpx 10rpx; border-radius: 29rpx 35rpx 31rpx 27rpx; color: var(--ink); display: flex; flex-direction: column; align-items: center; justify-content: center; transition: transform 120ms ease, box-shadow 120ms ease; }
.occasion-card.blue { background: var(--blue); border-color: rgba(64, 105, 130, .12); color: var(--ink); }
.occasion-card.red { background: var(--red); border-color: rgba(132, 32, 31, .16); color: #fffdf8; text-shadow: 0 2rpx 3rpx rgba(91, 20, 20, .22); }
.occasion-card.selected { transform: translateY(-5rpx) rotate(-1deg); box-shadow: 0 13rpx 0 rgba(132, 32, 31, .16); }
.occasion-icon { width: 124rpx; height: 104rpx; }
.occasion-icon-parents { transform: scale(1.28); }
.occasion-label { margin-top: 5rpx; font-family: var(--font-hand); font-weight: 400; font-size: 40rpx; line-height: 1.12; letter-spacing: 3rpx; }
.occasion-divider { height: 2rpx; margin: 14rpx 2rpx 12rpx; background: repeating-linear-gradient(90deg, var(--line) 0 12rpx, transparent 12rpx 20rpx); animation-delay: 130ms; }
.secondary-grid { animation-delay: 160ms; }
.card-pressed { transform: scale(.97); }
.browse { display: flex; min-height: 76rpx; margin: 12rpx auto 0; padding: 10rpx 24rpx 4rpx; align-items: center; justify-content: center; background: transparent; color: var(--ink); font-family: var(--font-hand); font-size: 32rpx; line-height: 1.2; letter-spacing: 2rpx; text-align: center; }.browse text { margin-left: 12rpx; color: var(--red); }.browse-pressed { opacity: .55; }
