.occasion-screen { position: relative; display: flex; flex-direction: column; overflow: hidden; }
.hero { margin-top: 70rpx; }
.eyebrow { display: block; margin-bottom: 22rpx; color: var(--muted); font-size: 24rpx; letter-spacing: 2rpx; }
.title { white-space: pre-line; font-size: 58rpx; line-height: 1.3; color: var(--ink); }
.blue-stroke { width: 188rpx; height: 8rpx; margin: 14rpx 0 0 10rpx; border-radius: 50%; border-top: 6rpx solid var(--blue); transform: rotate(-3deg); }
.mascot { position: absolute; top: calc(env(safe-area-inset-top) + 34rpx); right: 43rpx; width: 136rpx; height: 136rpx; transform: rotate(2deg); }
.occasion-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx 22rpx; animation-delay: 80ms; }
.primary-grid { margin-top: 38rpx; }
.occasion-card { height: 154rpx; margin: 0; padding: 14rpx 10rpx 11rpx; border-radius: 25rpx 31rpx 27rpx 23rpx; color: var(--ink); display: flex; flex-direction: column; align-items: center; justify-content: center; transition: transform 120ms ease, box-shadow 120ms ease; }
.occasion-card.blue { background: var(--blue); border-color: rgba(64, 105, 130, .12); }.occasion-card.red { background: var(--red); color: #fffaf2; }
.occasion-card.selected { transform: translateY(-5rpx) rotate(-1deg); box-shadow: 0 13rpx 0 rgba(132, 32, 31, .16); }
.occasion-icon { width: 82rpx; height: 67rpx; }
.occasion-label { margin-top: 3rpx; font-family: var(--font-hand); font-weight: 400; font-size: 31rpx; letter-spacing: 2rpx; }
.occasion-divider { height: 2rpx; margin: 27rpx 2rpx 25rpx; background: repeating-linear-gradient(90deg, var(--line) 0 12rpx, transparent 12rpx 20rpx); animation-delay: 130ms; }
.secondary-grid { animation-delay: 160ms; }
.secondary-card { height: 126rpx; flex-direction: row; gap: 8rpx; }
.secondary-icon { width: 67rpx; height: 58rpx; }
.secondary-label { margin-top: 0; font-size: 29rpx; }
.card-pressed { transform: scale(.97); }
.browse { margin: auto auto 0; padding: 22rpx 30rpx 8rpx; background: transparent; color: var(--ink); font-family: var(--font-hand); font-size: 27rpx; letter-spacing: 2rpx; }.browse text { margin-left: 10rpx; color: var(--red); }.browse-pressed { opacity: .55; }
