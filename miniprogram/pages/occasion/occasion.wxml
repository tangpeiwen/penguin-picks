<view class="screen occasion-screen">
  <image class="mascot" src="/assets/icons/mascot-red.png" mode="aspectFit" aria-label="饭碗小厨师"></image>

  <view class="hero fade-up">
    <view class="brand-lockup">
      <text class="brand-en">PEIWEN PICKS</text>
      <text class="brand-cn hand-title">吃饭也要做功课</text>
    </view>
    <view class="hand-title title">
      <view class="title-first-line">这顿饭，<view class="blue-stroke"></view></view>
      <view class="title-second-line">是个什么情况？</view>
    </view>
    <text class="hero-note">从我吃过的餐厅里，挑一家适合这顿饭的。</text>
  </view>

  <view class="occasion-grid primary-grid fade-up">
    <button
      wx:for="{{primaryOptions}}"
      wx:key="id"
      class="occasion-card paper-card {{item.tone}} {{selected === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="chooseOccasion"
      hover-class="card-pressed"
    >
      <image class="occasion-icon occasion-icon-{{item.id}}" src="{{item.icon}}" mode="aspectFit"></image>
      <text class="occasion-label">{{item.label}}</text>
    </button>
  </view>

  <view class="occasion-divider fade-up"></view>

  <view class="occasion-grid secondary-grid fade-up">
    <button
      wx:for="{{secondaryOptions}}"
      wx:key="id"
      class="occasion-card paper-card {{item.tone}} {{selected === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="chooseOccasion"
      hover-class="card-pressed"
    >
      <image class="occasion-icon occasion-icon-{{item.id}}" src="{{item.icon}}" mode="aspectFit"></image>
      <text class="occasion-label">{{item.label}}</text>
    </button>
  </view>

  <button class="browse" bindtap="explore" hover-class="browse-pressed">看看我都吃了什么 <text>→</text></button>
</view>
